<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup + device transfer (API 31+): không khôi phục JWT/session.
  Các prefs khác (settings, favorites cache, seismic…) vẫn backup bình thường.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="indoor_nav_session" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="indoor_nav_session" />
    </device-transfer>
</data-extraction-rules>
